# 支付宝 Vibe Pay 配置（沙箱模式留空即可演示全流程）
# 真实收款：按 alipay.alipay.com 的 Vibe Pay 接入提示，扫码授权后把密钥填到 .env
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱网关：https://openapi.alipaydev.com/gateway.do
# 正式网关：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 可选：配置后智能体团队调用真实大模型（否则走知识库兜底，0 成本）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

PORT=3000
